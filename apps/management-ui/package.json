  "type": "module",
  "version": "0.0.1-beta",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
