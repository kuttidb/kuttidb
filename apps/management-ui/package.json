{
  "name": "@kuttidb/management-ui",
  "type": "module",
  "version": "0.0.1-beta",
  "description": "Self-hosted web console for KuttiDB's Management API. Run it locally with `npx @kuttidb/management-ui` -- no clone or build required.",
  "keywords": ["kuttidb", "database", "admin", "console", "management", "dashboard"],
  "license": "Apache-2.0",
  "homepage": "https://kuttidb.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuttidb/kuttidb.git",
    "directory": "apps/management-ui"
  },
  "bugs": "https://github.com/kuttidb/kuttidb/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "kuttidb-management-ui": "dist/server/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.build.json && chmod +x dist/server/cli.js",
    "start": "node dist/server/index.js",
    "console": "node dist/server/cli.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck": "pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.14.0",
    "lucide-react": "^1.40.0",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.63.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
