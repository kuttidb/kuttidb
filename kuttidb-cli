#!/usr/bin/env python3
"""kuttidb-cli — command line client for the KuttiDB server.

Usage:
  kuttidb-cli put KEY VALUE [-]        store a record; '-' reads value from stdin
  kuttidb-cli get KEY                  print value (raw bytes to stdout)
  kuttidb-cli del KEY                  delete a record
  kuttidb-cli mget KEY [KEY ...]       print one value per line (misses -> empty)
  kuttidb-cli mput                     read "KEY<TAB>VALUE" lines from stdin
  kuttidb-cli queues                   inventory of declared queues (depth, in-flight)
  kuttidb-cli topics                   inventory of declared stream topics
  kuttidb-cli groups                   inventory of stream consumer groups
  kuttidb-cli stats                    show server stats
  kuttidb-cli health                   return success only when storage is ready
  kuttidb-cli capabilities             print negotiated protocol capabilities
  kuttidb-cli manifest                 queue inventory incl. stable incarnations (JSON)
  kuttidb-cli consumer-register NAME    register a durable named consumer (for job-consume)
  kuttidb-cli consumer-unregister NAME  remove a durable named consumer
  kuttidb-cli job-consume QUEUE CONSUMER [--visibility S] [--output FILE]
                                       receive a completion-capable delivery (JSON;
                                       the full proof is written only to FILE, 0600)
  kuttidb-cli job-complete --delivery FILE [--request FILE]
                                       [--operation-id UUID --queue Q --queue-incarnation N
                                        --message-id N --state-key K --expected-version N
                                        [--state-value SPEC] [--output-queue Q
                                        --output-incarnation N [--output-value SPEC]]]
                                       submit one atomic completion (JSON result)
  kuttidb-cli job-completion UUID      look up a retained completion receipt (JSON)
  kuttidb-cli state-get KEY            read durable state (JSON)
  kuttidb-cli state-put KEY --expected-version N [--operation-id UUID] [--value SPEC]
                                       version-checked durable-state PUT (JSON receipt)
  kuttidb-cli state-delete KEY --expected-version N [--operation-id UUID]
                                       version-checked durable-state DELETE (JSON receipt)
  kuttidb-cli durable-operation UUID   look up a retained state-mutation receipt (JSON)

Value SPEC: '-' reads stdin bytes, 'b64:...' decodes Base64, '@FILE' reads a
file, anything else is the literal argument bytes. 64-bit identity fields in
JSON output are lossless decimal STRINGS; byte values are Base64. Delivery
and intent files contain sensitive proof or payload data: they are created
only on explicit request with owner-only permissions and are never printed
to routine output.

Options:
  -H, --host HOST     server host (default 127.0.0.1, env KUTTIDB_HOST)
  -p, --port PORT     server port (default 7379, env KUTTIDB_PORT)
  --auth-file PATH    token file (env KUTTIDB_AUTH_FILE)
  --tls               require TLS (env KUTTIDB_TLS=1)
  --ca-file PATH      trusted certificate/CA file (env KUTTIDB_CA_FILE)
  --server-name NAME  certificate name (defaults to host)

Exit codes: 0 ok, 1 miss/not found, 2 connection, server, or validation
error, 3 conflict (idempotency or state version), 4 unknown outcome
(operation in doubt: preserve the operation id and retry exactly or look up
the receipt).
"""

import json
import os
import socket
import ssl
import struct
import sys
import uuid

OP_PUT = 0x01
OP_GET = 0x02
OP_DELETE = 0x03
OP_STATS = 0x04
OP_PUT_TTL = 0x05
OP_AUTH = 0x06
OP_HEALTH = 0x09
OP_CAPABILITIES = 0x0a
OP_PUT_BATCH = 0x11
OP_GET_BATCH = 0x12
OP_PUT_BATCH_TTL = 0x13
ST_OK = 0x00
ST_MISS = 0x01
ST_ERR = 0x02
MAX_KEY = (1 << 16) - 1
MAX_VALUE = 64 << 20
BATCH = 256


class CLIError(Exception):
    pass


class Conn:
    def __init__(self, host, port, auth_token=None, tls=False, ca_file=None,
                 server_name=None, unix_path=None):
        if unix_path:
            raw_sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            raw_sock.settimeout(10)
            raw_sock.connect(unix_path)
        else:
            raw_sock = socket.create_connection((host, port), timeout=10)
        if tls:
            context = ssl.create_default_context(cafile=ca_file)
            try:
                self.sock = context.wrap_socket(
                    raw_sock, server_hostname=server_name or host)
            except Exception:
                raw_sock.close()
                raise
        else:
            self.sock = raw_sock
        self.sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.buf = b""
        if auth_token is not None:
            if not auth_token or len(auth_token) > 1024:
                raise CLIError("auth token must contain 1..1024 bytes")
            self.send_req(single(OP_AUTH, auth_token))
            status, _ = read_resp(self)
            if status != ST_OK:
                raise CLIError("authentication failed")

    def recv_exact(self, n):
        while len(self.buf) < n:
            chunk = self.sock.recv(1 << 16)
            if not chunk:
                raise CLIError("connection closed")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def send_req(self, data):
        self.sock.sendall(data)


def single(op, key, value=b"", ttl_ms=0):
    kb = key.encode() if isinstance(key, str) else key
    if len(kb) > MAX_KEY:
        raise CLIError("key too large")
    if len(value) > MAX_VALUE:
        raise CLIError("value too large")
    if ttl_ms:
        return (bytes([op]) + struct.pack("<HII", len(kb), len(value), ttl_ms) + kb + value)
    return bytes([op]) + struct.pack("<HI", len(kb), len(value)) + kb + value


def parse_ttl(text):
    """'90' | '5m' | '2h' -> seconds"""
    mult = 1
    t = text.strip().lower()
    if t.endswith("ms"):
        return max(0.001, float(t[:-2]) / 1000.0)
    if t.endswith("s"):
        t = t[:-1]
    elif t.endswith("m"):
        t, mult = t[:-1], 60
    elif t.endswith("h"):
        t, mult = t[:-1], 3600
    elif t.endswith("d"):
        t, mult = t[:-1], 86400
    return float(t) * mult


def read_resp(c):
    status, vlen = struct.unpack("<BI", c.recv_exact(5))
    if vlen > MAX_VALUE:
        raise CLIError("invalid response length")
    return status, c.recv_exact(vlen) if vlen else b""


OP_QUEUE_LIST = 0x2c
OP_STREAM_LIST = 0x69
OP_STREAM_GROUP_LIST = 0x6a

# Atomic job completion family (capability-gated server side).
OP_JOB_CONSUME = 0x70
OP_JOB_COMPLETE = 0x71
OP_JOB_RECEIPT = 0x72
OP_STATE_GET = 0x73
OP_STATE_PUT = 0x74
OP_STATE_DELETE = 0x75
OP_DURABLE_OPERATION = 0x76
OP_QUEUE_MANIFEST = 0x77
OP_QUEUE_CONSUMER_REGISTER = 0x29
OP_QUEUE_CONSUMER_UNREGISTER = 0x2a

JOB_ERROR_NAMES = {
    1: "unsupported_feature", 2: "validation_failed", 3: "request_too_large",
    4: "idempotency_conflict", 5: "state_version_conflict", 6: "delivery_expired",
    7: "delivery_not_owned", 8: "resource_exhausted", 9: "operation_in_progress",
    10: "operation_in_doubt", 11: "persistence_unavailable", 12: "not_found",
}
JOB_CONFLICT_CODES = {"idempotency_conflict", "state_version_conflict"}


def _list_request(c, opcode):
    c.send_req(single(opcode, b"", b""))
    status, value = read_resp(c)
    if status != ST_OK:
        raise CLIError("inventory request failed")
    return value


def cmd_queues(c):
    value = _list_request(c, OP_QUEUE_LIST)
    (n,) = struct.unpack("<H", value[:2])
    at, rows = 2, []
    for _ in range(n):
        (nlen,) = struct.unpack("<H", value[at:at + 2])
        name = value[at + 2:at + 2 + nlen].decode()
        depth, inflight = struct.unpack("<QQ", value[at + 2 + nlen:at + 18 + nlen])
        rows.append((name, depth, inflight))
        at += 18 + nlen
    for name, depth, inflight in rows:
        print(f"{name}\tdepth={depth}\tinflight={inflight}")


def cmd_topics(c):
    value = _list_request(c, OP_STREAM_LIST)
    (n,) = struct.unpack("<H", value[:2])
    at, rows = 2, []
    for _ in range(n):
        (tlen,) = struct.unpack("<H", value[at:at + 2])
        topic = value[at + 2:at + 2 + tlen].decode()
        partitions, records, bts = struct.unpack("<IQQ", value[at + 2 + tlen:at + 22 + tlen])
        rows.append((topic, partitions, records, bts))
        at += 22 + tlen
    for topic, partitions, records, bts in rows:
        print(f"{topic}\tpartitions={partitions}\trecords={records}\tbytes={bts}")


def cmd_groups(c):
    value = _list_request(c, OP_STREAM_GROUP_LIST)
    (n,) = struct.unpack("<H", value[:2])
    at, rows = 2, []
    for _ in range(n):
        (tlen,) = struct.unpack("<H", value[at:at + 2])
        topic = value[at + 2:at + 2 + tlen].decode()
        (glen,) = struct.unpack("<H", value[at + 2 + tlen:at + 4 + tlen])
        group = value[at + 4 + tlen:at + 4 + tlen + glen].decode()
        generation, members = struct.unpack(
            "<QI", value[at + 4 + tlen + glen:at + 16 + tlen + glen])
        rows.append((topic, group, generation, members))
        at += 16 + tlen + glen
    for topic, group, generation, members in rows:
        print(f"{topic}/{group}\tgeneration={generation}\tmembers={members}")


def cmd_put(c, key, value, ttl_s=None):
    ttl_ms = max(1, int(ttl_s * 1000)) if ttl_s else 0
    op = OP_PUT_TTL if ttl_ms else OP_PUT
    c.send_req(single(op, key, value, ttl_ms))
    status, _ = read_resp(c)
    return status, None


def cmd_get(c, key):
    c.send_req(single(OP_GET, key))
    return read_resp(c)


def cmd_del(c, key):
    c.send_req(single(OP_DELETE, key))
    return read_resp(c)[0]


def cmd_mget(c, keys):
    result = {}
    for start in range(0, len(keys), BATCH):
        chunk = keys[start:start + BATCH]
        enc = [k.encode() for k in chunk]
        if any(len(kb) > MAX_KEY for kb in enc):
            raise CLIError("key too large")
        req = bytes([OP_GET_BATCH, 0, 0]) + struct.pack("<I", len(chunk))
        req += b"".join(struct.pack("<H", len(kb)) + kb for kb in enc)
        c.send_req(req)
        count = struct.unpack("<I", c.recv_exact(4))[0]
        for i in range(count):
            status, vlen = struct.unpack("<BI", c.recv_exact(5))
            if vlen > MAX_VALUE:
                raise CLIError("invalid response length")
            val = c.recv_exact(vlen) if vlen else b""
            if status == ST_MISS:
                result[chunk[i]] = None
            else:
                result[chunk[i]] = val
    return result


def cmd_mput(c, pairs, ttl_s=None):
    ttl_ms = max(1, int(ttl_s * 1000)) if ttl_s else 0
    op = OP_PUT_BATCH_TTL if ttl_ms else OP_PUT_BATCH
    items = list(pairs)
    for start in range(0, len(items), BATCH):
        chunk = items[start:start + BATCH]
        req = bytes([op, 0, 0]) + struct.pack("<I", len(chunk))
        for k, v in chunk:
            kb = k.encode()
            if len(kb) > MAX_KEY:
                raise CLIError("key too large")
            if len(v) > MAX_VALUE:
                raise CLIError("value too large")
            item_size = (10 if ttl_ms else 6) + len(kb) + len(v)
            if len(req) + item_size > MAX_VALUE:
                raise CLIError("batch too large")
            req += struct.pack("<HI", len(kb), len(v))
            if ttl_ms:
                req += struct.pack("<I", ttl_ms)
            req += kb + v
        c.send_req(req)
        status = c.recv_exact(1)[0]
        if status != ST_OK:
            raise CLIError("server error in mput")



# ---- atomic job completion helpers -----------------------------------------

def _job_error_body(body):
    """Maps a typed error envelope to a CLI exit code."""
    code = body[0] if len(body) >= 1 else 0
    outcome = body[1] if len(body) >= 2 else 0
    name = JOB_ERROR_NAMES.get(code, f"code_{code}")
    detail = body[2:].decode(errors="replace") if len(body) > 2 else ""
    text = f"{name} ({'unknown' if outcome else 'not_committed'})"
    if detail:
        text += f": {detail}"
    exit_code = 4 if name == "operation_in_doubt" else (
        3 if name in JOB_CONFLICT_CODES else 2)
    return exit_code, text


def _job_call(c, opcode, key, value=b""):
    """Sends one job request and returns (status, body) raw."""
    c.send_req(single(opcode, key, value))
    return read_resp(c)


def _expect_json(value):
    return json.loads(value.decode())


def _b64e(data):
    import base64
    return base64.b64encode(data).decode("ascii")


def _b64d(text):
    import base64
    return base64.b64decode(text.encode("ascii"))



def _load_value(spec):
    if spec == "-":
        return sys.stdin.buffer.read()
    if spec.startswith("b64:"):
        return _b64d(spec[4:])
    if spec.startswith("@"):
        with open(spec[1:], "rb") as f:
            return f.read()
    return spec.encode()


def _write_private_file(path, data):
    """Owner-only file for sensitive delivery/intent data: created only on
    explicit request, never world-readable."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(data)


def _json_out(obj):
    print(json.dumps(obj, sort_keys=True))


def _uuid_bytes(text):
    return uuid.UUID(text).bytes


def _manifest_rows(c):
    status, value = _job_call(c, OP_QUEUE_MANIFEST, b"", b"")
    if status == ST_ERR:
        # Surface the typed error (e.g. unsupported_feature on a server
        # without --job-completion) instead of a bare failure message.
        return None, _job_error_body(value) if len(value) >= 2 else (2, "manifest failed")
    if status != ST_OK:
        return None, (2, "manifest failed")
    (n,) = struct.unpack("<H", value[:2])
    at, rows = 2, []
    for _ in range(n):
        (nlen,) = struct.unpack("<H", value[at:at + 2]); at += 2
        name = value[at:at + nlen].decode(); at += nlen
        durable = value[at]; at += 1
        inc, depth, inflight, maxd, rev = struct.unpack("<QQQQQ", value[at:at + 40])
        at += 40
        rows.append({"name": name, "durable": bool(durable),
                     "incarnation": str(inc), "depth": str(depth),
                     "inflight": str(inflight), "max_depth": str(maxd),
                     "revision": str(rev)})
    return rows, None


def cmd_manifest(c):
    rows, error = _manifest_rows(c)
    if error is not None:
        code, text = error
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    for row in rows:
        _json_out(row)
    return 0


def cmd_consumer_register(c, rest):
    if len(rest) != 1:
        print("usage: kuttidb-cli consumer-register NAME", file=sys.stderr)
        return 2
    status, value = _job_call(c, OP_QUEUE_CONSUMER_REGISTER, rest[0].encode())
    if status != ST_OK:
        raise CLIError("consumer registration failed")
    print(f"owner={struct.unpack('<Q', value)[0]}")
    return 0


def cmd_consumer_unregister(c, rest):
    if len(rest) != 1:
        print("usage: kuttidb-cli consumer-unregister NAME", file=sys.stderr)
        return 2
    status, _ = _job_call(c, OP_QUEUE_CONSUMER_UNREGISTER, rest[0].encode())
    if status != ST_OK:
        raise CLIError("consumer unregistration failed")
    return 0


def cmd_job_consume(c, rest):
    queue = None
    consumer = None
    visibility = 30.0
    output = None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--visibility":
            visibility = parse_ttl(rest[i + 1]); i += 2
        elif a == "--output":
            output = rest[i + 1]; i += 2
        elif queue is None:
            queue = a; i += 1
        elif consumer is None:
            consumer = a; i += 1
        else:
            raise CLIError("job-consume: too many arguments")
    if not queue or not consumer:
        print("usage: kuttidb-cli job-consume QUEUE CONSUMER "
              "[--visibility 90|5m|2h] [--output FILE]", file=sys.stderr)
        return 2
    gb = consumer.encode()
    status, value = _job_call(c, OP_JOB_CONSUME, queue.encode(),
                              struct.pack("<H", len(gb)) + gb +
                              struct.pack("<Q", int(visibility * 1000)))
    if status == ST_MISS:
        return 1
    if status == ST_ERR:
        code, text = _job_error_body(value)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    if status != ST_OK or len(value) < 61:
        raise CLIError("job consume failed")
    delivery = {
        "store_id": _b64e(value[0:16]),
        "queue": queue,
        "queue_incarnation": str(struct.unpack("<Q", value[16:24])[0]),
        "message_id": str(struct.unpack("<Q", value[24:32])[0]),
        "attempts": struct.unpack("<I", value[32:36])[0],
        "redelivered": bool(value[36]),
        "lease_deadline_ms": str(struct.unpack("<Q", value[37:45])[0]),
        "proof": _b64e(value[45:61]),
        "value": _b64e(value[61:]),
    }
    if output:
        _write_private_file(output, json.dumps(delivery, sort_keys=True).encode())
        safe = dict(delivery)
        safe["proof"] = "(written to " + output + ")"
        _json_out(safe)
    else:
        # Routine output never includes the proof.
        safe = dict(delivery)
        safe["proof"] = "(use --output FILE to persist it)"
        safe["value"] = delivery["value"]
        _json_out(safe)
    return 0


def cmd_job_complete(c, rest):
    delivery_file = None
    request_file = None
    fields = {}
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--delivery", "--request", "--operation-id", "--queue",
                 "--state-key", "--state-value", "--output-queue",
                 "--output-value"):
            key = a[2:].replace("-", "_")
            fields[key] = rest[i + 1]; i += 2
        elif a in ("--queue-incarnation", "--message-id", "--expected-version",
                   "--output-incarnation"):
            key = a[2:].replace("-", "_")
            fields[key] = int(rest[i + 1]); i += 2
        else:
            print(f"kuttidb-cli: job-complete: unknown argument {a}",
                  file=sys.stderr)
            return 2
    delivery_file = fields.pop("delivery", None)
    request_file = fields.pop("request", None)
    if request_file:
        with open(request_file, "rb") as f:
            intent = _expect_json(f.read())
    else:
        if delivery_file:
            with open(delivery_file, "rb") as f:
                delivery = _expect_json(f.read())
            intent = {
                "operation_id": fields.get("operation_id") or _new_uuid(),
                "input": {"queue": fields.get("queue", delivery["queue"]),
                          "queue_incarnation": str(fields.get(
                              "queue_incarnation",
                              int(delivery["queue_incarnation"]))),
                          "message_id": str(fields.get(
                              "message_id", int(delivery["message_id"])))},
                "state": {"key": _b64e(_load_value(fields["state_key"])
                                       if "state_key" in fields else b""),
                          "expected_version": str(fields.get(
                              "expected_version", 0)),
                          "value": _b64e(_load_value(fields["state_value"])
                                         if "state_value" in fields else b"")},
                "output": None if "output_queue" not in fields else {
                    "queue": fields["output_queue"],
                    "queue_incarnation": str(fields.get(
                        "output_incarnation", 0)),
                    "value": _b64e(_load_value(fields["output_value"])
                                   if "output_value" in fields else b"")},
            }
        else:
            print("usage: kuttidb-cli job-complete --delivery FILE "
                  "[--request FILE] or compose with --queue/--message-id/...",
                  file=sys.stderr)
            return 2
    proof = b""
    if delivery_file:
        with open(delivery_file, "rb") as f:
            proof = _b64d(_expect_json(f.read())["proof"])
    req = intent
    sk = _b64d(req["state"]["key"])
    sv = _b64d(req["state"]["value"])
    out = req.get("output")
    value = (_uuid_bytes(req["operation_id"]) +
             struct.pack("<QQ", int(req["input"]["queue_incarnation"]),
                         int(req["input"]["message_id"])) + proof +
             struct.pack("<H", len(sk)) + sk +
             struct.pack("<Q", int(req["state"]["expected_version"])) +
             struct.pack("<I", len(sv)) + sv)
    if out is None:
        value += b"\x00"
    else:
        oq = out["queue"].encode()
        ov = _b64d(out["value"])
        value += (b"\x01" + struct.pack("<H", len(oq)) + oq +
                  struct.pack("<Q", int(out["queue_incarnation"])) +
                  struct.pack("<I", len(ov)) + ov)
    status, resp = _job_call(c, OP_JOB_COMPLETE, req["input"]["queue"].encode(),
                             value)
    if status == ST_MISS:
        return 1
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    if status != ST_OK or len(resp) != 41:
        raise CLIError("job completion failed")
    commit, version, out_msg, completed, expires = struct.unpack(
        "<QQQQQ", resp[:40])
    _json_out({"commit_id": str(commit), "state_version": str(version),
               "output_message_id": str(out_msg),
               "completed_at_ms": str(completed),
               "receipt_expires_at_ms": str(expires),
               "replayed": bool(resp[40])})
    return 0


def _new_uuid():
    return str(uuid.uuid4())


def cmd_job_completion(c, rest):
    if len(rest) != 1:
        print("usage: kuttidb-cli job-completion OPERATION_ID", file=sys.stderr)
        return 2
    status, resp = _job_call(c, OP_JOB_RECEIPT, b"", _uuid_bytes(rest[0]))
    if status == ST_MISS:
        return 1
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    commit, version, out_msg, completed, expires = struct.unpack(
        "<QQQQQ", resp[:40])
    _json_out({"operation_id": rest[0], "commit_id": str(commit),
               "state_version": str(version),
               "output_message_id": str(out_msg),
               "completed_at_ms": str(completed),
               "receipt_expires_at_ms": str(expires)})
    return 0


def cmd_state_get(c, rest):
    if len(rest) != 1:
        print("usage: kuttidb-cli state-get KEY", file=sys.stderr)
        return 2
    status, resp = _job_call(c, OP_STATE_GET, rest[0].encode())
    if status == ST_MISS:
        return 1
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    version, commit = struct.unpack("<QQ", resp[:16])
    _json_out({"key": rest[0], "version": str(version),
               "commit_id": str(commit), "value": _b64e(resp[16:])})
    return 0


def cmd_state_put(c, rest):
    key = None
    expected = 0
    op_id = None
    value_spec = ""
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--expected-version":
            expected = int(rest[i + 1]); i += 2
        elif a == "--operation-id":
            op_id = rest[i + 1]; i += 2
        elif a == "--value":
            value_spec = rest[i + 1]; i += 2
        elif key is None:
            key = a; i += 1
        else:
            print("usage: kuttidb-cli state-put KEY --expected-version N "
                  "[--operation-id UUID] [--value SPEC]", file=sys.stderr)
            return 2
    if not key or expected < 0:
        print("usage: kuttidb-cli state-put KEY --expected-version N "
              "[--operation-id UUID] [--value SPEC]", file=sys.stderr)
        return 2
    value = _load_value(value_spec) if value_spec else b""
    status, resp = _job_call(c, OP_STATE_PUT, key.encode(),
                             (_uuid_bytes(op_id) if op_id else
                              _uuid_bytes(_new_uuid())) +
                             struct.pack("<Q", expected) + value)
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    if status != ST_OK or len(resp) != 33:
        raise CLIError("durable state put failed")
    commit, version, completed, expires = struct.unpack("<QQQQ", resp[:32])
    _json_out({"key": key, "commit_id": str(commit),
               "state_version": str(version),
               "completed_at_ms": str(completed),
               "receipt_expires_at_ms": str(expires),
               "replayed": bool(resp[32])})
    return 0


def cmd_state_delete(c, rest):
    key = None
    expected = None
    op_id = None
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--expected-version":
            expected = int(rest[i + 1]); i += 2
        elif a == "--operation-id":
            op_id = rest[i + 1]; i += 2
        elif key is None:
            key = a; i += 1
        else:
            print("usage: kuttidb-cli state-delete KEY --expected-version N "
                  "[--operation-id UUID]", file=sys.stderr)
            return 2
    if not key or not expected or expected <= 0:
        print("usage: kuttidb-cli state-delete KEY --expected-version N "
              "[--operation-id UUID]", file=sys.stderr)
        return 2
    status, resp = _job_call(c, OP_STATE_DELETE, key.encode(),
                             (_uuid_bytes(op_id) if op_id else
                              _uuid_bytes(_new_uuid())) +
                             struct.pack("<Q", expected))
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    if status != ST_OK or len(resp) != 33:
        raise CLIError("durable state delete failed")
    commit, version, completed, expires = struct.unpack("<QQQQ", resp[:32])
    _json_out({"key": key, "commit_id": str(commit),
               "state_version": str(version),
               "completed_at_ms": str(completed),
               "receipt_expires_at_ms": str(expires),
               "replayed": bool(resp[32])})
    return 0


def cmd_durable_operation(c, rest):
    if len(rest) != 1:
        print("usage: kuttidb-cli durable-operation OPERATION_ID",
              file=sys.stderr)
        return 2
    status, resp = _job_call(c, OP_DURABLE_OPERATION, b"", _uuid_bytes(rest[0]))
    if status == ST_MISS:
        return 1
    if status == ST_ERR:
        code, text = _job_error_body(resp)
        print(f"kuttidb-cli: {text}", file=sys.stderr)
        return code
    kind = {2: "state_put", 3: "state_delete"}.get(
        resp[0], f"kind_{resp[0]}")
    commit, version, completed, expires = struct.unpack("<QQQQ", resp[1:33])
    _json_out({"operation_id": rest[0], "kind": kind,
               "commit_id": str(commit), "state_version": str(version),
               "completed_at_ms": str(completed),
               "receipt_expires_at_ms": str(expires)})
    return 0


def main(argv):
    host = os.environ.get("KUTTIDB_HOST", "127.0.0.1")
    port = int(os.environ.get("KUTTIDB_PORT", "7379"))
    auth_file = os.environ.get("KUTTIDB_AUTH_FILE")
    use_tls = os.environ.get("KUTTIDB_TLS", "").lower() in ("1", "true", "yes")
    ca_file = os.environ.get("KUTTIDB_CA_FILE")
    server_name = None
    unix_path = os.environ.get("KUTTIDB_UNIX")
    show_help = False
    args = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-H", "--host"):
            host = argv[i + 1]
            i += 2
        elif a in ("-p", "--port"):
            port = int(argv[i + 1])
            i += 2
        elif a in ("-h", "--help"):
            show_help = True
            i += 1
        elif a == "--auth-file":
            auth_file = argv[i + 1]
            i += 2
        elif a == "--tls":
            use_tls = True
            i += 1
        elif a == "--ca-file":
            ca_file = argv[i + 1]
            i += 2
        elif a == "--server-name":
            server_name = argv[i + 1]
            i += 2
        elif a == "--unix-path":
            unix_path = argv[i + 1]
            i += 2
        else:
            args.append(a)
            i += 1

    if show_help:
        print(__doc__)
        return 0
    if not args:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, rest = args[0], args[1:]

    try:
        auth_token = None
        if auth_file:
            with open(auth_file, "rb") as f:
                auth_token = f.read(1025).rstrip(b"\r\n")
            if not auth_token or len(auth_token) > 1024:
                raise CLIError("auth token file must contain 1..1024 bytes")
        c = Conn(host, port, auth_token, use_tls, ca_file, server_name,
                 unix_path)
    except (OSError, CLIError) as e:
        endpoint = unix_path or f"{host}:{port}"
        print(f"kuttidb-cli: cannot connect to {endpoint} ({e})", file=sys.stderr)
        return 2

    try:
        if cmd == "put":
            ttl_s = None
            clean = []
            i = 0
            while i < len(rest):
                if rest[i] == "--ttl":
                    ttl_s = parse_ttl(rest[i + 1])
                    i += 2
                else:
                    clean.append(rest[i])
                    i += 1
            if len(clean) < 2:
                print("usage: kuttidb-cli put KEY VALUE|- [--ttl 90|5m|2h]", file=sys.stderr)
                return 2
            key, valspec = clean[0], clean[1]
            value = sys.stdin.buffer.read() if valspec == "-" else valspec.encode()
            status, _ = (cmd_put(c, key, value, ttl_s))
            if status != ST_OK:
                raise CLIError("server rejected put")
        elif cmd == "get":
            if len(rest) != 1:
                print("usage: kuttidb-cli get KEY", file=sys.stderr)
                return 2
            status, value = cmd_get(c, rest[0])
            if status == ST_MISS:
                return 1
            if status != ST_OK:
                raise CLIError("server error")
            sys.stdout.buffer.write(value)
            sys.stdout.buffer.flush()
        elif cmd == "del":
            if len(rest) != 1:
                print("usage: kuttidb-cli del KEY", file=sys.stderr)
                return 2
            return 0 if cmd_del(c, rest[0]) == ST_OK else 1
        elif cmd == "mget":
            if not rest:
                print("usage: kuttidb-cli mget KEY...", file=sys.stderr)
                return 2
            res = cmd_mget(c, rest)
            for k in rest:
                v = res.get(k)
                sys.stdout.buffer.write(b"" if v is None else v)
                sys.stdout.buffer.write(b"\n")
        elif cmd == "mput":
            ttl_s = None
            clean = []
            i = 0
            while i < len(rest):
                if rest[i] == "--ttl":
                    ttl_s = parse_ttl(rest[i + 1])
                    i += 2
                else:
                    clean.append(rest[i])
                    i += 1
            pairs = []
            for line in sys.stdin.buffer.read().split(b"\n"):
                if not line:
                    continue
                if b"\t" not in line:
                    raise CLIError(f"mput line missing TAB separator: {line[:40]!r}")
                k, v = line.split(b"\t", 1)
                pairs.append((k.decode(), v))
            cmd_mput(c, pairs, ttl_s)
            print(f"stored {len(pairs)} records", file=sys.stderr)
        elif cmd == "stats":
            c.send_req(single(OP_STATS, b""))
            status, value = read_resp(c)
            if status != ST_OK:
                raise CLIError("stats unavailable")
            print(value.decode())
        elif cmd == "health":
            c.send_req(single(OP_HEALTH, b""))
            status, _ = read_resp(c)
            if status != ST_OK:
                raise CLIError("server is not ready")
        elif cmd == "capabilities":
            c.send_req(single(OP_CAPABILITIES, b"", struct.pack("<HH", 1, 2)))
            status, value = read_resp(c)
            if status != ST_OK or len(value) != 12:
                raise CLIError("capability negotiation failed")
            major, minor, features = struct.unpack("<HHQ", value)
            print(f"protocol={major}.{minor} features=0x{features:016x}")
        elif cmd == "queues":
            cmd_queues(c)
        elif cmd == "topics":
            cmd_topics(c)
        elif cmd == "groups":
            cmd_groups(c)
        elif cmd == "manifest":
            rc = cmd_manifest(c)
            return rc
        elif cmd == "consumer-register":
            rc = cmd_consumer_register(c, rest)
            return rc
        elif cmd == "consumer-unregister":
            rc = cmd_consumer_unregister(c, rest)
            return rc
        elif cmd == "job-consume":
            rc = cmd_job_consume(c, rest)
            return rc
        elif cmd == "job-complete":
            rc = cmd_job_complete(c, rest)
            return rc
        elif cmd == "job-completion":
            rc = cmd_job_completion(c, rest)
            return rc
        elif cmd == "state-get":
            rc = cmd_state_get(c, rest)
            return rc
        elif cmd == "state-put":
            rc = cmd_state_put(c, rest)
            return rc
        elif cmd == "state-delete":
            rc = cmd_state_delete(c, rest)
            return rc
        elif cmd == "durable-operation":
            rc = cmd_durable_operation(c, rest)
            return rc
        else:
            print(f"unknown command: {cmd}", file=sys.stderr)
            return 2
    except CLIError as e:
        print(f"kuttidb-cli: {e}", file=sys.stderr)
        return 2
    finally:
        c.sock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
